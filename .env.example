# Copy this file to .env.local when enabling a live OpenAI model.
# Never commit the real key.
OPENAI_API_KEY=
OPENAI_MODEL=
# Unsafe outside an isolated local smoke test. Live providers otherwise require
# DATABASE_URL plus the complete AI account budget configuration below.
# AI_ALLOW_UNMETERED_LIVE_MODEL=false
# For an OpenAI Responses-compatible endpoint, use these instead of OPENAI_API_KEY.
# OPENAI_COMPATIBLE_API_KEY=
# OPENAI_COMPATIBLE_BASE_URL=https://provider.example/v1
# OPENAI_COMPATIBLE_MODEL=
AI_API_HOST=127.0.0.1
AI_API_PORT=8787

# Required together when developing the account sync service.
# Run npm run db:migrate before enabling it. Use exact comma-separated origins.
DATABASE_URL=
SYNC_ALLOWED_ORIGINS=http://127.0.0.1:5173
# Optional; defaults to ai_learning_os_session.
SESSION_COOKIE_NAME=

# Required together for authenticated live-model usage accounting.
# AI_MONTHLY_TOKEN_LIMIT=250000
# AI_MONTHLY_COST_LIMIT_USD=12.50
# AI_INPUT_COST_PER_MILLION_USD=<current-model-input-price>
# AI_OUTPUT_COST_PER_MILLION_USD=<current-model-output-price>

# Optional OIDC login. Configure all four values together.
# OIDC_ISSUER=https://identity.example
# OIDC_CLIENT_ID=ai-learning-os
# OIDC_REDIRECT_URI=http://127.0.0.1:8787/api/auth/callback
# OIDC_TRANSACTION_SECRET=replace-with-at-least-32-random-characters
