# Copy this file to .env.local when enabling a live OpenAI model.
# Never commit the real key.
OPENAI_API_KEY=
OPENAI_MODEL=
AI_API_PORT=8787

# Required together when developing the account sync service.
# Run npm run db:migrate before enabling it. Use exact comma-separated origins.
DATABASE_URL=
SYNC_ALLOWED_ORIGINS=http://127.0.0.1:5173
# Optional; defaults to ai_learning_os_session.
SESSION_COOKIE_NAME=
