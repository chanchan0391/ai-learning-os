{
  "name": "ai-learning-os",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/chanchan0391/ai-learning-os.git"
  },
  "engines": {
    "node": ">=22.23.1 <23"
  },
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api \"vite\" \"tsx watch server/index.ts\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/index.ts",
    "preview": "vite preview",
    "db:migrate": "tsx server/sync/migrate.ts",
    "eval:agents": "tsx server/evals/run-agent-evaluation.ts",
    "acceptance:oidc-sync": "playwright test --config=playwright.acceptance.config.ts",
    "start": "concurrently -k -n web,api \"vite --host 127.0.0.1 --open\" \"tsx server/index.ts\"",
    "build": "tsc -b && vite build && tsx server/operations/check-frontend-build-budget.ts",
    "test": "vitest run",
    "check": "npm run test && npm run build"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.1.0",
    "jose": "^6.2.10",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "vite": "^8.2.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "axe-core": "^4.13.0",
    "concurrently": "^10.0.5",
    "jsdom": "^30.0.1",
    "pg-mem": "^3.0.14",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
