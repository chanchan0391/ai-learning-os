{
  "name": "ai-learning-os",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/chanchan0391/ai-learning-os.git"
  },
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api \"vite\" \"tsx watch server/index.ts\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/index.ts",
    "preview": "vite preview",
    "db:migrate": "tsx server/sync/migrate.ts",
    "start": "concurrently -k -n web,api \"vite --host 127.0.0.1 --open\" \"tsx server/index.ts\"",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "check": "npm run test && npm run build"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "jose": "^6.2.6",
    "pg": "^8.22.0",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "latest",
    "@types/pg": "^8.20.2",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "axe-core": "^4.12.1",
    "concurrently": "latest",
    "jsdom": "^29.1.1",
    "pg-mem": "^3.0.14",
    "tsx": "latest",
    "typescript": "latest",
    "vitest": "latest"
  }
}
