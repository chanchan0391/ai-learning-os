[Unit]
Description=AI Learning OS API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/services/ai-learning-os/current
EnvironmentFile=%h/services/ai-learning-os/app.env
ExecStart=%h/.nvm/versions/node/v22.23.1/bin/node --import tsx server/index.ts
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
